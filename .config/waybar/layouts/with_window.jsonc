{
    "layer" : "top",
    "position" : "top",
    "width" : 1920,
    "margin" : "5 0",

    "group/gleft1" : {
        "orientation": "horizontal",
        "modules" : [
            "battery", "cpu", "memory" 
        ]
    },

    "group/gleft2" : {
        "orientation": "horizontal",
        "modules" : [
            "hyprland/workspaces", "hyprland/window"
        ]
    },


    "group/gright1" : {
        "orientation": "horizontal",
        "modules" : [
            "tray", "wireplumber", "temperature"
        ]
    },

    "modules-left"   : ["power-profiles-daemon", "group/gleft1", "group/gleft2"],
    "modules-center" : ["mpris"],
    "modules-right"  : [ "group/gright1", "custom/power"],

    "include": [ "~/.config/waybar/modules.jsonc" ]
    
}
